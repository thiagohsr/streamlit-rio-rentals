# Chat assistant backend — any OpenAI-compatible endpoint with tool-calling.
# Copy to .env and fill in real values; .env is git-ignored.
LLM_BASE_URL=https://ollama.interfacesdigitais.com.br/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# Only needed if LLM_BASE_URL is gated by Cloudflare Access (e.g. the public
# tunnel hostname above, as opposed to a local/LAN address). Create a
# dedicated Cloudflare Access service token for this app — see
# ~/Workspace/ollama-homelab/cloudflare-tunnel-setup.md — and set both:
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
